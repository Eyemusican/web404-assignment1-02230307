<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Log In - CSRF Demo</title>
</head>
<body>
  <h1>Log In</h1>

  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <form action="/login" method="POST">
    <label>
      Username:
      <input type="text" name="username" />
    </label>
    <br />
    <label>
      Password:
      <input type="password" name="password" />
    </label>
    <br />
    <button type="submit">Log in</button>
  </form>

  <p>Test user: <code>testuser</code> / <code>password123</code></p>
</body>
</html>
